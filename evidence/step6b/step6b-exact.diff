+#!/usr/bin/env python3
+"""Isolated real poll driver. Each command runs once; no automatic retries."""
+import argparse
+import datetime
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+
+ACK = Path(__file__).resolve().parent
+HOME = ACK.parent / 'real-home'
+STATE = HOME / 'hooks/state/muse-hub'
+POLL = '/home/hatch/hooks/scripts/director-watch-poll.sh'
+ENV = dict(os.environ, HOME=str(HOME), PATH='/usr/bin:/bin',
+           MUSE_HUB_REPO='xy3293/muse-hub-test',
+           GITHUB_API_BASE='https://api.github.com', HATCH_HOOK_DRY_RUN='0')
+
+
+def write(path, value):
+    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
+
+
+def run(argv):
+    result = subprocess.run(argv, env=ENV, text=True, capture_output=True, timeout=120)
+    if result.returncode or not result.stdout.strip():
+        raise SystemExit(f'FAIL exit={result.returncode}: {argv[0]}\n'
+                         f'{result.stdout}\n{result.stderr}')
+    return result.stdout
+
+
+def snapshot():
+    return dict(scan=json.loads((STATE / 'scan.json').read_text()),
+                events={p.name: json.loads(p.read_text())
+                        for p in sorted((STATE / 'events').glob('*.json'))})
+
+
+parser = argparse.ArgumentParser(description=__doc__)
+commands = parser.add_subparsers(dest='command', required=True)
+init = commands.add_parser('init', help='Initialize once using confirmed initial head')
+init.add_argument('sha')
+poll = commands.add_parser('poll', help='One real invocation, capturing all evidence')
+poll.add_argument('label')
+poll.add_argument('--min-remaining', type=int, default=10)
+args = parser.parse_args()
+
+if args.command == 'init':
+    if not re.fullmatch('[0-9a-f]{40}', args.sha):
+        raise SystemExit('FAIL expected full confirmed GitHub SHA')
+    if any(HOME.iterdir()):
+        raise SystemExit('FAIL real-home must be empty; never reset existing state')
+    template = json.loads(Path('/home/hatch/hooks/state/muse-hub/scan.json').read_text())
+    scan = {k: template[k] for k in ('schema_version', 'scan_cursor',
+                                    'scan_cursor_updated_at', 'comments')}
+    scan.update(schema_version=1, scan_cursor=args.sha, comments={},
+                scan_cursor_updated_at=datetime.datetime.now(datetime.timezone.utc).isoformat())
+    for name in ('events', 'receipts', 'logs'):
+        (STATE / name).mkdir(parents=True, exist_ok=True)
+    write(STATE / 'scan.json', scan)
+    print(f'PASS initialized {STATE} cursor={args.sha}')
+else:
+    if not re.fullmatch('[A-Za-z0-9_-]+', args.label):
+        raise SystemExit('FAIL invalid evidence label')
+    prefix = ACK / ('step6b-real-' + args.label)
+    if Path(str(prefix) + '.rate.json').exists():
+        raise SystemExit('FAIL label already used; inspect evidence, do not overwrite')
+    rate_text = run(['/usr/bin/curl', '-sS', '--fail', '--max-time', '15',
+                     'https://api.github.com/rate_limit'])
+    Path(str(prefix) + '.rate.json').write_text(rate_text)
+    remaining = json.loads(rate_text)['resources']['core']['remaining']
+    if remaining < max(10, args.min_remaining):
+        raise SystemExit(f'NOT TESTED rate remaining={remaining}; stopped before poll')
+    before = snapshot()
+    write(Path(str(prefix) + '.before.json'), before)
+    result = subprocess.run(['/bin/bash', POLL], env=ENV, text=True,
+                            capture_output=True, timeout=180)
+    Path(str(prefix) + '.stdout').write_text(result.stdout)
+    Path(str(prefix) + '.stderr').write_text(result.stderr)
+    after = snapshot()
+    health = json.loads((STATE / 'health.json').read_text()) if (STATE / 'health.json').exists() else {}
+    write(Path(str(prefix) + '.after.json'), dict(**after, health=health))
+    with (ACK / 'step6b-real-rounds.jsonl').open('a') as log:
+        log.write(json.dumps(dict(label=args.label, exit=result.returncode,
+                                 cursor_before=before['scan']['scan_cursor'],
+                                 cursor_after=after['scan']['scan_cursor'],
+                                 remaining=health.get('rate', {}).get('remaining'),
+                                 stdout=result.stdout)) + '\n')
+    lines = result.stdout.splitlines()
+    if result.returncode or len(lines) != 1 or not lines[0].startswith('RESULT '):
+        raise SystemExit(f'FAIL exit={result.returncode}; inspect {prefix}; no retry')
+    output = json.loads(lines[0][7:])
+    if output['reason'] == 'api-failure':
+        raise SystemExit(f'FAIL {result.stdout.strip()}; no retry')
+    print(result.stdout, end='')
+    print(f"health.remaining={health.get('rate', {}).get('remaining')} evidence={prefix}")
